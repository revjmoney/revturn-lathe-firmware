diff --git a/platformio.ini b/platformio.ini
index ee57cd1..4a2602a 100644
--- a/platformio.ini
+++ b/platformio.ini
@@ -364,3 +364,25 @@ board_build.f_flash = 40000000L
 board_upload.flash_size = 4MB
 monitor_speed=115200
 
+
+# Rev's mini lathe: REVTURN ESP32 DevKit (WROOM-32, 4 MB). Board map + options in main/my_machine.h
+[env:revturn_lathe]
+platform = espressif32 @ ~4.0.0
+framework = espidf
+board = esp32doit-devkit-v1
+board_build.partitions = partitions.csv
+board_build.embed_files =
+    main/embedded/favicon.ico
+    main/embedded/ap_login.html
+    main/embedded/index.html.gz
+    main/embedded/lathe.html.gz
+build_flags =
+    -Wimplicit-fallthrough=1
+    -Wno-missing-field-initializers
+    -Wno-maybe-uninitialized
+    -Wno-stringop-truncation
+    -DCONFIG_IDF_TARGET_ESP32=1
+upload_port = COM15
+monitor_port = COM15
+monitor_speed = 115200
+lib_compat_mode = off
