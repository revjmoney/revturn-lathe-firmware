<phyphox version="1.7" locale="en">
    <title>REVTURN Mic 4 (sound + shake)</title>
    <category>REVTURN</category>
    <description>Keeps the WHOLE microphone recording (48 kHz) and the accelerometer (without g) so a PC can pull it over Remote access as one WAV. REVTURN by JMSCNC.</description>
    <data-containers>
        <container size="0">rec</container>
        <container size="0">all</container>
        <container size="1">rate</container>
        <container size="0">accX</container>
        <container size="0">accY</container>
        <container size="0">accZ</container>
        <container size="0">acc_time</container>
        <container size="1">n</container>
        <container size="1">secs</container>
    </data-containers>
    <input>
        <audio rate="48000">
            <output>rec</output>
            <output component="rate">rate</output>
        </audio>
        <sensor type="linear_acceleration" rate="0">
            <output component="x">accX</output>
            <output component="y">accY</output>
            <output component="z">accZ</output>
            <output component="t">acc_time</output>
        </sensor>
    </input>
    <analysis sleep="0">
        <append>
            <input clear="true">rec</input>
            <output clear="false">all</output>
        </append>
        <count>
            <input clear="false">all</input>
            <output>n</output>
        </count>
        <divide>
            <input clear="false">n</input>
            <input clear="false">rate</input>
            <output>secs</output>
        </divide>
    </analysis>
    <views>
        <view label="REVTURN Mic">
            <value label="Recorded" precision="1" unit="s" size="2">
                <input>secs</input>
            </value>
            <value label="Sample rate" precision="0" unit="Hz">
                <input>rate</input>
            </value>
        </view>
    </views>
    <export>
        <set name="Audio">
            <data name="Samples">all</data>
        </set>
        <set name="Acceleration">
            <data name="t (s)">acc_time</data>
            <data name="x (m/s^2)">accX</data>
            <data name="y (m/s^2)">accY</data>
            <data name="z (m/s^2)">accZ</data>
        </set>
    </export>
</phyphox>
